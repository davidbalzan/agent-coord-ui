# agent-coord-ui API — environment

# Port the API + WS server listens on (web client connects here).
API_PORT=3000

# Allowed CORS origin for the web app.
CORS_ORIGIN=http://localhost:5173

# ─── Phase 8 auth ──────────────────────────────────────────────────────────────
# Set BOTH to enforce JWT auth on every privileged surface (PTY, spawn/teardown,
# send-keys, send_message, preset + backlog writes). If either is unset, the
# server falls back to loopback-only (pre-Phase-8 behaviour) and logs a warning.
#
# AUTH_JWT_SECRET — HS256 signing key, >= 32 chars. Generate a strong random
#   value, e.g.:  openssl rand -base64 48
# AUTH_PASSWORD   — the shared operator password exchanged for a token at
#   POST /api/auth/login.
#
# AUTH_JWT_SECRET=replace-with-a-32+char-random-secret
# AUTH_PASSWORD=replace-with-a-strong-operator-password

# Token lifetime (any `jose`-accepted duration string).
AUTH_TOKEN_TTL=12h

# Keep loopback as a hard extra layer (recommended for local v1). Set to "false"
# only for an intentional authenticated network deployment (Phase 9).
AUTH_REQUIRE_LOOPBACK=true
